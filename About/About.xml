<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Overlord Warcasket</name>
  <author>Sam Hunt</author>
  <packageId>shunter.overlordwarcasket</packageId>
  <modVersion>0.1.0</modVersion>
  <description>Adds the Overlord warcasket, a spacer-tier mechanitor armor set for VFE Pirates, welded at the warcasket foundry like any other. Its shell carries a resurrection core that brings your fallen mechs back, and its pilot can still gestate and repair mechs, research and hack. Compatible with SOS2, VGE and Combat Extended. Requires Biotech and Vanilla Factions Expanded - Pirates.</description>
